# Local-only service: this image never needs outbound network access at runtime.
FROM python:3.12-slim AS builder
WORKDIR /app
COPY requirements.txt .
ARG WITH_VIZ=0
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt
COPY requirements-viz.txt .
RUN if [ "$WITH_VIZ" = "1" ]; then pip install --no-cache-dir --prefix=/install -r requirements-viz.txt; fi

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY grid ./grid
COPY api ./api
COPY config ./config

RUN useradd --no-create-home --uid 1000 grid && chown -R grid /app
USER grid

EXPOSE 8000
ENV GRID_CONFIG=config/default.json
HEALTHCHECK --interval=10s --timeout=3s CMD python -c \
    "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]